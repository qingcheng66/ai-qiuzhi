# ===== LLM 供应商 =====
# deepseek | openrouter | mock
LLM_PROVIDER=openrouter
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# 显式强制 mock（即使上方配了 key）
LLM_MOCK=false

# ===== OCR — PaddleOCR（本地 Python 3.12 独立进程，最高优先级）=====
# PaddleOCR 无需配置 key，pip install paddleocr 后自动生效
# 若 PaddleOCR 不可用，按以下顺序降级：
# MinerU > 百度OCR > 腾讯OCR > Mock

# ===== OCR — MinerU 文档解析（第二优先级）=====
MINERU_OCR_TOKEN=your_mineru_ocr_token_here
MINERU_OCR_MODEL=pipeline

# ===== OCR（百度/腾讯，第三/第四优先级）=====
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

# ===== 数据库 =====
# 默认 SQLite，生产切换为 PostgreSQL 连接串
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ai_qiuzhi

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173